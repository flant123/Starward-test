<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.ActivityCalendar.ActivityCalendarWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.ActivityCalendar"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Loaded="RootGrid_Loaded">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Grid Padding="16,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE787;"
                          IsTextScaleFactorEnabled="False" />
                <TextBlock x:Name="TextBlock_Title"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{x:Bind lang:Lang.ActivityCalendar_Title}" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind RefreshCommand}"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind lang:Lang.ActivityCalendar_Refresh}">
                <FontIcon FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE72C;"
                          IsTextScaleFactorEnabled="False" />
            </Button>
        </Grid>

        <!--  加载中  -->
        <StackPanel x:Name="StackPanel_Loading"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <ProgressRing Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          IsIndeterminate="True" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.ActivityCalendar_Loading}" />
        </StackPanel>

        <!--  加载失败  -->
        <StackPanel x:Name="StackPanel_Error"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
            <FontIcon HorizontalAlignment="Center"
                      FontSize="32"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Glyph="&#xE7BA;"
                      IsTextScaleFactorEnabled="False" />
            <TextBlock x:Name="TextBlock_Error"
                       MaxWidth="360"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!--  活动列表  -->
        <Pivot x:Name="Pivot_Activities"
               Grid.Row="1"
               Visibility="Collapsed">
            <Pivot.Resources>
                <Thickness x:Key="PivotItemMargin">0,0,0,0</Thickness>
                <Thickness x:Key="PivotHeaderItemMargin">24,0,24,0</Thickness>
            </Pivot.Resources>

            <!--  进行中  -->
            <PivotItem Header="{x:Bind lang:Lang.ActivityCalendar_Ongoing}">
                <Grid>
                    <ScrollViewer Padding="24,8,24,24"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind OngoingActivities}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:ActivityCalendarItem">
                                    <Grid Padding="12"
                                          ColumnSpacing="12"
                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          CornerRadius="8"
                                          Tapped="ActivityItem_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <sc:CachedImage Width="132"
                                                        Height="74"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="6"
                                                        Source="{x:Bind Banner}"
                                                        Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                            <TextBlock MaxLines="2"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{x:Bind Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind TimeRangeText}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <Border Padding="6,1,6,1"
                                                        Background="{x:Bind StatusBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock FontSize="10"
                                                               Foreground="White"
                                                               IsTextScaleFactorEnabled="False"
                                                               Text="{x:Bind StatusText}" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           IsTextScaleFactorEnabled="False"
                                                           Text="{x:Bind TagLabel}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock x:Name="TextBlock_NoOngoing"
                               Margin="0,40,0,0"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.ActivityCalendar_NoActivities}"
                               Visibility="Collapsed" />
                </Grid>
            </PivotItem>

            <!--  即将开始  -->
            <PivotItem Header="{x:Bind lang:Lang.ActivityCalendar_Upcoming}">
                <Grid>
                    <ScrollViewer Padding="24,8,24,24"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind UpcomingActivities}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:ActivityCalendarItem">
                                    <Grid Padding="12"
                                          ColumnSpacing="12"
                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          CornerRadius="8"
                                          Tapped="ActivityItem_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <sc:CachedImage Width="132"
                                                        Height="74"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="6"
                                                        Source="{x:Bind Banner}"
                                                        Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                            <TextBlock MaxLines="2"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{x:Bind Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind TimeRangeText}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <Border Padding="6,1,6,1"
                                                        Background="{x:Bind StatusBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock FontSize="10"
                                                               Foreground="White"
                                                               IsTextScaleFactorEnabled="False"
                                                               Text="{x:Bind StatusText}" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           IsTextScaleFactorEnabled="False"
                                                           Text="{x:Bind TagLabel}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock x:Name="TextBlock_NoUpcoming"
                               Margin="0,40,0,0"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.ActivityCalendar_NoActivities}"
                               Visibility="Collapsed" />
                </Grid>
            </PivotItem>

            <!--  已结束  -->
            <PivotItem Header="{x:Bind lang:Lang.ActivityCalendar_Ended}">
                <Grid>
                    <ScrollViewer Padding="24,8,24,24"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind EndedActivities}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:ActivityCalendarItem">
                                    <Grid Padding="12"
                                          ColumnSpacing="12"
                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          CornerRadius="8"
                                          Tapped="ActivityItem_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <sc:CachedImage Width="132"
                                                        Height="74"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="6"
                                                        Source="{x:Bind Banner}"
                                                        Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                            <TextBlock MaxLines="2"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{x:Bind Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind TimeRangeText}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <Border Padding="6,1,6,1"
                                                        Background="{x:Bind StatusBrush}"
                                                        CornerRadius="4">
                                                    <TextBlock FontSize="10"
                                                               Foreground="White"
                                                               IsTextScaleFactorEnabled="False"
                                                               Text="{x:Bind StatusText}" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           IsTextScaleFactorEnabled="False"
                                                           Text="{x:Bind TagLabel}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock x:Name="TextBlock_NoEnded"
                               Margin="0,40,0,0"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.ActivityCalendar_NoActivities}"
                               Visibility="Collapsed" />
                </Grid>
            </PivotItem>

        </Pivot>

    </Grid>

</sf:WindowEx>
