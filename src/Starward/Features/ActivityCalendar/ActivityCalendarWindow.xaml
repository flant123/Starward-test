<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.ActivityCalendar.ActivityCalendarWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.ActivityCalendar"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="#FF0B0D0F"
          Loaded="RootGrid_Loaded"
          SizeChanged="RootGrid_SizeChanged">

        <Grid.Resources>

            <!--  奖励图标槽（黑色描边 + 金色边框 + 圆角方形）  -->
            <Style x:Key="RewardSlotStyle" TargetType="Border">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Background" Value="#FF0E1012" />
                <Setter Property="BorderBrush" Value="#FFD4AF37" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!--  圆形进入按钮（黑色圆 + 银灰金属边框 + 白色箭头，悬停发光旋转）  -->
            <Style x:Key="MetalCircleButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#FF101010" />
                <Setter Property="BorderBrush" Value="#FF9AA0A8" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="18">
                                    <ContentPresenter x:Name="ButtonContent"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                        <ContentPresenter.RenderTransform>
                                            <RotateTransform x:Name="ContentRotate" Angle="0" />
                                        </ContentPresenter.RenderTransform>
                                    </ContentPresenter>
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 To="0"
                                                                 Duration="0:0:0.18" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FF9AA0A8" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 To="90"
                                                                 Duration="0:0:0.18" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFB347" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderThickness">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="2" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FF353535" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--  金属小按钮（刷新）  -->
            <Style x:Key="MetalIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#FF1A1D21" />
                <Setter Property="BorderBrush" Value="#FF5A6068" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="BtnBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFB347" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FF30353C" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </Grid.Resources>


        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="96" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- ================= 背景层（机械纹理 / 网格 / 扫描线） ================= -->

        <Grid Grid.RowSpan="3">

            <!--  垂直网格线（活动区周轨道）  -->
            <Grid Grid.Row="1" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Left" Fill="#0DFFFFFF" />
                <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Left" Fill="#0DFFFFFF" />
                <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Left" Fill="#0DFFFFFF" />
                <Rectangle Grid.Column="4" Width="1" HorizontalAlignment="Left" Fill="#0DFFFFFF" />
                <Rectangle Grid.Column="5" Width="1" HorizontalAlignment="Left" Fill="#0DFFFFFF" />
            </Grid>

            <!--  扫描线  -->
            <Border Grid.RowSpan="3" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.35">
                        <GradientStop Offset="0.00" Color="#00000000" />
                        <GradientStop Offset="0.008" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.05" Color="#00000000" />
                        <GradientStop Offset="0.058" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.10" Color="#00000000" />
                        <GradientStop Offset="0.108" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.15" Color="#00000000" />
                        <GradientStop Offset="0.158" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.20" Color="#00000000" />
                        <GradientStop Offset="0.208" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.25" Color="#00000000" />
                        <GradientStop Offset="0.258" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.30" Color="#00000000" />
                        <GradientStop Offset="0.308" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.35" Color="#00000000" />
                        <GradientStop Offset="0.358" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.40" Color="#00000000" />
                        <GradientStop Offset="0.408" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.45" Color="#00000000" />
                        <GradientStop Offset="0.458" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.50" Color="#00000000" />
                        <GradientStop Offset="0.508" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.55" Color="#00000000" />
                        <GradientStop Offset="0.558" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.60" Color="#00000000" />
                        <GradientStop Offset="0.608" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.65" Color="#00000000" />
                        <GradientStop Offset="0.658" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.70" Color="#00000000" />
                        <GradientStop Offset="0.708" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.75" Color="#00000000" />
                        <GradientStop Offset="0.758" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.80" Color="#00000000" />
                        <GradientStop Offset="0.808" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.85" Color="#00000000" />
                        <GradientStop Offset="0.858" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.90" Color="#00000000" />
                        <GradientStop Offset="0.908" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.95" Color="#00000000" />
                        <GradientStop Offset="0.958" Color="#0DFFFFFF" />
                        <GradientStop Offset="1.00" Color="#00000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!--  上下边缘暗化  -->
            <Border Grid.RowSpan="3" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#66000000" />
                        <GradientStop Offset="0.15" Color="#00000000" />
                        <GradientStop Offset="0.85" Color="#00000000" />
                        <GradientStop Offset="1.0" Color="#88000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!--  金属装饰条（顶部橙红渐变线）  -->
            <Border Height="2"
                    Margin="0,46,0,0"
                    VerticalAlignment="Top">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0.0" Color="#00FF6A2A" />
                        <GradientStop Offset="0.5" Color="#FFFF6A2A" />
                        <GradientStop Offset="1.0" Color="#00FF6A2A" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!--  角落螺丝装饰  -->
            <Grid Margin="10,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Ellipse Width="10" Height="10" Fill="#FF3A3E45" />
                <Ellipse Width="4" Height="4" Fill="#FF17191C" />
            </Grid>
            <Grid Margin="0,8,10,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Ellipse Width="10" Height="10" Fill="#FF3A3E45" />
                <Ellipse Width="4" Height="4" Fill="#FF17191C" />
            </Grid>
            <Grid Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Ellipse Width="10" Height="10" Fill="#FF3A3E45" />
                <Ellipse Width="4" Height="4" Fill="#FF17191C" />
            </Grid>
            <Grid Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Ellipse Width="10" Height="10" Fill="#FF3A3E45" />
                <Ellipse Width="4" Height="4" Fill="#FF17191C" />
            </Grid>
        </Grid>


        <!-- ================= 标题栏 ================= -->

        <Grid Grid.Row="0" Padding="44,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                <FontIcon FontSize="16"
                          Foreground="#FFFF6A2A"
                          Glyph="&#xE787;"
                          IsTextScaleFactorEnabled="False" />
                <TextBlock x:Name="TextBlock_Title"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           CharacterSpacing="80"
                           Foreground="#FFE8EAED"
                           Text="{x:Bind lang:Lang.ActivityCalendar_Title}" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="10"
                           CharacterSpacing="120"
                           Foreground="#665A6068"
                           Text="ACTIVITY CONTROL // SW-CAL"
                           IsTextScaleFactorEnabled="False" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind RefreshCommand}"
                    Style="{StaticResource MetalIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind lang:Lang.ActivityCalendar_Refresh}">
                <FontIcon FontSize="12"
                          Foreground="#FFC8CDD3"
                          Glyph="&#xE72C;"
                          IsTextScaleFactorEnabled="False" />
            </Button>
        </Grid>


        <!-- ================= 时间轴（连续机械轨道，代码生成） ================= -->

        <Grid x:Name="TimelineGrid"
              Grid.Row="1"
              Padding="24,10,24,14"
              SizeChanged="TimelineGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
        </Grid>


        <!-- ================= 活动列表 ================= -->

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="ActivityScrollViewer"
                          Padding="24,8,24,24"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto">
                <ItemsRepeater x:Name="ActivityRepeater" ItemsSource="{x:Bind Activities}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:ActivityCalendarItem">
                            <Grid x:Name="CardRoot"
                                  Padding="0"
                                  ColumnSpacing="0"
                                  Background="{x:Bind CardBrush}"
                                  BorderBrush="{x:Bind CardBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Loaded="CardRoot_Loaded"
                                  Opacity="{x:Bind CardOpacity}"
                                  PointerEntered="Card_PointerEntered"
                                  PointerExited="Card_PointerExited"
                                  Tapped="ActivityItem_Tapped">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  左侧橙红强调条（进行中）  -->
                                <Rectangle Grid.Column="0"
                                           RadiusX="2"
                                           RadiusY="2"
                                           Fill="{x:Bind AccentStripBrush}" />

                                <!--  封面图（小尺寸圆角矩形，黑色描边 + 金属边框）  -->
                                <Grid Grid.Column="1"
                                      Width="52"
                                      Height="34"
                                      Margin="8,6,4,6"
                                      VerticalAlignment="Center">
                                    <Border Width="52"
                                            Height="34"
                                            Background="#FF0A0B0D"
                                            BorderBrush="#FF000000"
                                            BorderThickness="2"
                                            CornerRadius="6">
                                        <Border BorderBrush="#FF5A6068"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <sc:CachedImage Source="{x:Bind Banner}"
                                                            Stretch="UniformToFill"
                                                            CornerRadius="5" />
                                        </Border>
                                    </Border>
                                    <!--  已结束完成勾选  -->
                                    <Border Width="17"
                                            Height="17"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="#FF23262A"
                                            BorderBrush="#FF8A8F98"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Visibility="{x:Bind ShowCheckmark}">
                                        <FontIcon HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  FontSize="9"
                                                  Foreground="#FFD5D9DE"
                                                  Glyph="&#xE73E;"
                                                  IsTextScaleFactorEnabled="False" />
                                    </Border>
                                    <!--  新活动闪烁提示  -->
                                    <Ellipse x:Name="NewActivityDot"
                                             Width="8"
                                             Height="8"
                                             Margin="0,0,-2,0"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Fill="#FFFF4B45"
                                             Visibility="{x:Bind IsNew}" />
                                </Grid>

                                <!--  中间信息（三行高密度）  -->
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock MaxLines="1"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   CharacterSpacing="40"
                                                   Foreground="#FFFAFBFC"
                                                   Text="{x:Bind Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 VerticalAlignment="Center"
                                                 Fill="{x:Bind StatusDotBrush}"
                                                 Visibility="{x:Bind ShowStatusDot}" />
                                    </StackPanel>
                                    <TextBlock FontSize="11"
                                               CharacterSpacing="20"
                                               Foreground="#99E8EAED"
                                               Text="{x:Bind TimeRangeText}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   CharacterSpacing="20"
                                                   Foreground="#FFE8C36A"
                                                   Text="{x:Bind RemainingText}" />
                                        <TextBlock FontSize="10.5"
                                                   CharacterSpacing="30"
                                                   Foreground="#66E8EAED"
                                                   Text="{x:Bind TagLabel}" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  右侧：奖励图标 + 状态 + 机械按钮  -->
                                <StackPanel Grid.Column="3"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                    <!--  奖励展示区（浮动动画）  -->
                                    <StackPanel x:Name="RewardPanel"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="RewardFloat" Y="0" />
                                        </StackPanel.RenderTransform>
                                        <Border Style="{StaticResource RewardSlotStyle}">
                                            <FontIcon HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      FontSize="12"
                                                      Foreground="#FFE8C36A"
                                                      Glyph="&#xE734;"
                                                      IsTextScaleFactorEnabled="False" />
                                        </Border>
                                        <Border Style="{StaticResource RewardSlotStyle}">
                                            <FontIcon HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      FontSize="12"
                                                      Foreground="#FFE8C36A"
                                                      Glyph="&#xE8E7;"
                                                      IsTextScaleFactorEnabled="False" />
                                        </Border>
                                        <Border Style="{StaticResource RewardSlotStyle}">
                                            <FontIcon HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      FontSize="12"
                                                      Foreground="#FFE8C36A"
                                                      Glyph="&#xE74C;"
                                                      IsTextScaleFactorEnabled="False" />
                                        </Border>
                                    </StackPanel>
                                    <!--  状态文字  -->
                                    <StackPanel MinWidth="46"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   CharacterSpacing="60"
                                                   Foreground="{x:Bind StatusBrush}"
                                                   Text="{x:Bind StatusText}" />
                                        <Border Width="36"
                                                Height="2"
                                                HorizontalAlignment="Right"
                                                Background="{x:Bind StatusBrush}"
                                                CornerRadius="1"
                                                Opacity="0.5" />
                                    </StackPanel>
                                    <!--  机械进入按钮  -->
                                    <Button Click="EnterButton_Click"
                                            Style="{StaticResource MetalCircleButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind lang:Lang.ActivityCalendar_OpenDetail}">
                                        <FontIcon FontSize="12"
                                                  Foreground="#FFFFFFFF"
                                                  Glyph="&#xE72A;"
                                                  IsTextScaleFactorEnabled="False" />
                                    </Button>
                                </StackPanel>

                                <!--  悬停高亮覆盖层  -->
                                <Border x:Name="HoverOverlay"
                                        Grid.ColumnSpan="4"
                                        Background="#12FFFFFF"
                                        CornerRadius="8"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!--  空状态  -->
            <TextBlock x:Name="TextBlock_NoActivities"
                       Margin="0,60,0,0"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       CharacterSpacing="80"
                       Foreground="#8CE8EAED"
                       Text="{x:Bind lang:Lang.ActivityCalendar_NoActivities}"
                       Visibility="Collapsed" />
        </Grid>


        <!-- ================= 红色定位线（当前日期，贯穿时间轴与活动区） ================= -->

        <Canvas x:Name="NowLineCanvas"
                Grid.Row="1"
                Grid.RowSpan="2"
                IsHitTestVisible="False">

            <!--  当前日期红色胶囊  -->
            <Border x:Name="NowCapsule"
                    MinWidth="56"
                    Height="26"
                    Padding="8,0,8,0"
                    CornerRadius="13"
                    Background="#FFE04440">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                    <Ellipse Width="6"
                             Height="6"
                             VerticalAlignment="Center"
                             Fill="#FFFFFFFF" />
                    <TextBlock x:Name="TextBlock_NowCapsule"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Bold"
                               CharacterSpacing="20"
                               Foreground="#FFFFFFFF"
                               IsTextScaleFactorEnabled="False" />
                </StackPanel>
            </Border>

            <!--  红色垂直定位线  -->
            <Rectangle x:Name="NowLine"
                       Width="2"
                       RadiusX="1"
                       RadiusY="1"
                       Fill="#DDFF4B45" />

            <!--  定位线底部圆形终点  -->
            <Ellipse x:Name="NowLineDot"
                     Width="10"
                     Height="10"
                     Fill="#FFFF4B45" />
        </Canvas>


        <!-- ================= 加载中 ================= -->

        <StackPanel x:Name="StackPanel_Loading"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14"
                    Visibility="Collapsed">
            <ProgressRing Width="44"
                          Height="44"
                          HorizontalAlignment="Center"
                          Foreground="#FFFF6A2A"
                          IsIndeterminate="True" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="12"
                       CharacterSpacing="100"
                       Foreground="#8CE8EAED"
                       Text="{x:Bind lang:Lang.ActivityCalendar_Loading}" />
        </StackPanel>


        <!-- ================= 加载失败 ================= -->

        <StackPanel x:Name="StackPanel_Error"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
            <FontIcon HorizontalAlignment="Center"
                      FontSize="30"
                      Foreground="#FFFF6A2A"
                      Glyph="&#xE7BA;"
                      IsTextScaleFactorEnabled="False" />
            <TextBlock x:Name="TextBlock_Error"
                       MaxWidth="380"
                       FontSize="13"
                       CharacterSpacing="30"
                       Foreground="#8CE8EAED"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

    </Grid>

</sf:WindowEx>
